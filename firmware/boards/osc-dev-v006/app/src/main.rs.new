#![no_std]
#![no_main]

mod osc_security;

use osc_security::{Ecc204SwiPin, OscSecurityContext, NONCE_LEN, SIG_LEN};
use osc_servo_ch32::prelude::*;

use panic_halt as _;

#[cfg(feature = "defmt")]
use defmt_rtt as _;

tinyboot_ch32::app::app_version!();
osc_servo_ch32::install_isrs!();

#[qingke_rt::entry]
fn main() -> ! {
    osc_servo_ch32::log::info!("osc-dev-v006: boot");

    // 1. Initialize Single-Wire Interface (SWI) on PC1 for ECC204
    // PC1 is used exclusively for SWI, leaving PC2 free for bus.tx_en
    let pc1_pin = osc_servo_ch32::hal::gpio::Pin::PC1;
    let mut swi_bus = Ecc204SwiPin::new(pc1_pin);
    let mut sec_ctx = OscSecurityContext::new();

    let host_challenge: [u8; NONCE_LEN] = [0xAA; 32]; // Received over TTL bus during boot
    let mut servo_nonce = [0u8; NONCE_LEN];
    let mut boot_signature = [0u8; SIG_LEN];

    // 2. Perform 1-wire boot authentication & derive RAM session key
    if let Err(_e) = sec_ctx.boot_authenticate_swi(
        &mut swi_bus,
        &host_challenge,
        &mut servo_nonce,
        &mut boot_signature,
    ) {
        osc_servo_ch32::log::error!("ECC204 SWI Auth Failed!");
    } else {
        osc_servo_ch32::log::info!("ECC204 Auth Success. K_session loaded.");
    }

    // 3. Hand off control to the main OpenServoCore framework
    osc_servo_ch32::run!(BoardConfig {
        wiring: BoardWiring {
            dbg: DigitalPin::PC3,
            drv_en: DrvEn {
                pin: DigitalPin::PD0,
                active: Level::High,
            },
            // Rev B TTL bus subsystem: PC2 drives TX_EN without pin collision
            #[cfg(not(feature = "half-duplex"))]
            bus: BusWiring { tx_en: Pin::PC2 },
            current_sense: CurrentSenseConfig {
                gain: opa::Gain::X32,
                bias: opa::Bias::MidRail,
            },
            sensors: AdcPins {
                pos: AnalogChannel::A3,
                ntc: AnalogChannel::A2,
                vbus: AnalogChannel::A1,
                vmotor: (AnalogChannel::A5, AnalogChannel::A6),
            },
        },
        calibration: Calibration {
            shunt_r_mohm: 10,
            vbus_divider: Divider {
                top_ohm: 20_000,
                bot_ohm: 10_000,
            },
            vmotor_divider: Divider {
                top_ohm: 20_000,
                bot_ohm: 10_000,
            },
            // TH1 SDNT2012X103F3950FTF.
            ntc: NtcCal {
                beta: 3950,
                r0_ohm: 10_000,
                t0_cc: 2500,
                bias_r_ohm: 10_000,
            },
        },
        defaults: ConfigDefaults {
            pos_min_phys_urad: -1_570_796,
            pos_max_phys_urad: 1_570_796,
            vdd_mv: 3300,
            id: 1,
            baud: BaudRate::B1000000,
            response_deadline_us: DEFAULT_RESPONSE_DEADLINE_US,
        },
        model: MODEL_OSC_SERVO,
        hw_rev: 1,
    })
}
