// Markdown lint configuration.
//
// Project standard (AGENTS.md): strict linting, all rules enforced. The
// exemptions below are deliberate and documented, not blanket opt-outs.
{
    "config": {
        "default": true,

        // MD013 line-length: OFF, matching this repository's actual practice.
        // The authoritative docs (control-theory.md, osc-native-protocol.md,
        // README.md) are written as unwrapped prose paragraphs, and
        // REFERENCES.md holds long canonical URLs that must not be broken.
        // Turning this on would flag many hundreds of pre-existing lines in
        // documents that are correct as written. Revisit only as a deliberate
        // repo-wide reflow -- TODO.md sec 9.1.
        "MD013": false,

        // MD041 first-line-heading: the AI-assistant stubs (CLAUDE.md,
        // .github/copilot-instructions.md) are one-line pointers to AGENTS.md
        // by design; a heading on a redirect adds nothing.
        "MD041": false,

        // MD024 duplicate headings: REFERENCES.md repeats per-entry subheads,
        // which is what makes it a catalogue.
        "MD024": { "siblings_only": true }
    },
    "ignores": [
        "**/node_modules/**",
        "**/target/**",
        "firmware-old/**"
    ]
}
