(version 1)

(rule "Track width minimum"
  (condition "A.Type == 'Track'")
  (constraint track_width (min 0.10mm))
)

(rule "Copper clearance"
  (condition "A.Net != B.Net")
  (constraint clearance (min 0.10mm))
)

(rule "Global drill size limits"
  (constraint hole_size (min 0.30mm) (max 6.00mm))
)

(rule "Via drill + annular ring"
  (condition "A.Type == 'Via'")
  (constraint hole_size (min 0.30mm))
  (constraint annular_width (min 0.125mm))
)

(rule "PTH drill limits"
  (condition "A.Type == 'Pad' && A.Pad_Type == 'Through-hole' && A.isPlated()")
  (constraint hole_size (min 0.30mm) (max 6.00mm))
)

(rule "PTH annular ring"
  (condition "A.Type == 'Pad' && A.Pad_Type == 'Through-hole' && A.isPlated()")
  (constraint annular_width (min 0.125mm))
)

(rule "Hole-to-hole spacing"
  (condition "A.Net != B.Net")
  (constraint hole_to_hole (min 0.30mm))
)

(rule "Via-to-via stitching"
  (condition "A.Type == 'Via' && B.Type == 'Via' && A.Net == B.Net")
  (constraint hole_to_hole (min 0.20mm))
)

(rule "Copper to board edge"
  ; Fabrication-driven, not electrical: at the 8.4 V max working voltage of this
  ; board IPC-2221B Table 6-1 (B1, external uncoated, <= 3050 m) asks only
  ; 0.10 mm, which the global copper clearance rule above already meets.
  ; The binding number is the fabricator's routing tolerance.  PCBWay quotes
  ; 0.25 mm copper-to-outline for the normal CNC-routing process and rejects
  ; artwork below 0.20 mm.  0.30 mm is 1.5x that DFM gate. [REF-FAB-001]
  (condition "A.Type == 'Track' || A.Type == 'Via' || A.Type == 'Pad'")
  (constraint edge_clearance (min 0.30mm))
)

; NOTE - hole-to-board-edge is NOT expressible as a KiCad DRC rule.
; PCBWay requires >= 0.50 mm from any hole (PTH or NPTH) to the board outline
; [REF-FAB-001], which is stricter than the 0.30 mm copper rule above and is
; what actually limits how close a via may sit to the edge (via centre 0.65 mm
; in, for the 0.55/0.30 mm via used here).  KiCad's physical_hole_clearance
; constraint only evaluates hole-against-item pairs; it does not consider
; Edge.Cuts graphics, verified empirically against kicad-cli 10.0.3 by running
; the constraint unconditioned (199 hits) and then conditioned on
; "B.Layer == 'Edge.Cuts'" (0 hits).  The rule is therefore enforced outside
; DRC, by hardware/tools/check_hole_to_edge.py.

(rule "Silk text thickness"
  (layer "?.Silkscreen")
  (condition "A.Type == 'Text' || A.Type == 'Text Box'")
  (constraint text_thickness (min 0.12mm))
)

(rule "Silk text height"
  (layer "?.Silkscreen")
  (condition "A.Type == 'Text' || A.Type == 'Text Box'")
  (constraint text_height (min 0.80mm))
)

(rule "One-sided PTH annulus for Potentiometer"
  (condition "A.Type == 'Pad' && A.Pad_Type == 'Through-hole' && A.memberOfFootprint('shared:Pot_Wire_Pads')")
  (constraint annular_width (min 0.0mm))
)
